{
  "manifest_version": 3,
  "name": "CairnTab",
  "short_name": "CairnTab",
  "version": "0.1.0",
  "description": "Tasks stay, tabs come and go. A new tab page that turns one bookmarks folder into pins, tasks and an inbox, so reminder tabs stop eating memory.",
  "homepage_url": "https://github.com/tutul",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "開啟 CairnTab（新分頁）",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "minimum_chrome_version": "116",
  "chrome_url_overrides": {
    "newtab": "newtab.html"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": [
    "bookmarks",
    "tabs",
    "tabGroups",
    "storage",
    "alarms",
    "favicon",
    "contextMenus"
  ]
}
